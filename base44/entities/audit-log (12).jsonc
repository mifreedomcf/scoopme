{
  "name": "Notification",
  "description": "A queued or delivered notification. Bodies are rendered from templates that are forbidden from containing exact addresses, minor locations, or sensitive trip purposes. Deduplicated by idempotency_key.",
  "type": "object",
  "properties": {
    "recipient_user_id": { "type": "string" },
    "recipient_email": { "type": "string", "format": "email" },
    "recipient_phone": { "type": "string", "rls": { "read": { "user_condition": { "role": "admin" } } } },
    "channel": { "type": "string", "enum": ["email", "sms", "in_app"] },
    "template_key": { "type": "string" },
    "subject": { "type": "string" },
    "body": { "type": "string", "description": "Rendered body. Passed through the redaction check before write." },
    "ride_request_id": { "type": "string" },
    "idempotency_key": { "type": "string", "description": "Unique per (recipient, template, subject entity, state)." },
    "status": { "type": "string", "enum": ["queued", "sent", "failed", "suppressed_provider_missing", "suppressed_rate_limit", "read"], "default": "queued" },
    "attempt_count": { "type": "integer", "default": 0 },
    "last_error_code": { "type": "string" },
    "queued_at": { "type": "string", "format": "date-time" },
    "sent_at": { "type": "string", "format": "date-time" },
    "read_at": { "type": "string", "format": "date-time" }
  },
  "required": ["channel", "template_key", "idempotency_key"],
  "rls": {
    "create": false,
    "read": { "$or": [{ "created_by": "{{user.email}}" }, { "user_condition": { "role": "admin" } }] },
    "update": false,
    "delete": false
  }
}
