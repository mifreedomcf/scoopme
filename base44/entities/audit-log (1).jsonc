{
  "name": "AuditLog",
  "description": "Append-only audit trail. Written only by backend functions via service role. No client may create, update, or delete. Never contains secrets, full addresses, credential numbers, or incident narratives.",
  "type": "object",
  "properties": {
    "event_type": { "type": "string", "description": "e.g. ride.transition, config.update, gate.update, export.sensitive, credential.review, access.minor_record." },
    "actor_user_id": { "type": "string" },
    "actor_email": { "type": "string" },
    "actor_role": { "type": "string" },
    "subject_entity": { "type": "string", "description": "Entity name the event concerns." },
    "subject_id": { "type": "string" },
    "action": { "type": "string", "enum": ["create", "read", "update", "delete", "transition", "approve", "reject", "override", "export", "login", "reject_denied"] },
    "outcome": { "type": "string", "enum": ["allowed", "denied", "error"], "default": "allowed" },
    "reason_code": { "type": "string" },
    "from_state": { "type": "string" },
    "to_state": { "type": "string" },
    "justification": { "type": "string", "description": "Required, typed, for any override." },
    "request_ip": { "type": "string", "description": "Recorded only where lawful; truncated to /24." },
    "metadata": { "type": "object", "description": "Small non-sensitive key/value context. Redacted server-side before write." },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "required": ["event_type", "action", "occurred_at"],
  "rls": { "create": false, "read": { "user_condition": { "role": "admin" } }, "update": false, "delete": false }
}
